# Dashboard image. streamlit pulls in pyarrow, which may not install on s390x.
# If the build fails there, run the dashboard on a laptop with API_URL pointing at the server.
FROM python:3.11-slim
WORKDIR /app
COPY requirements-ui.txt .
RUN pip install --no-cache-dir -r requirements-ui.txt
COPY app ./app
EXPOSE 8501
CMD ["streamlit", "run", "app/dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
